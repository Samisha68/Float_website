{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules"]
}
